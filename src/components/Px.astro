---
import index from '../data/emoji-index.json';

/** An emoji, crunched to 10×10 pixels at build time, drawn from one shared sprite. Decorative. */
interface Props { e: string; lead?: boolean }
const { e, lead } = Astro.props;
const i = (index as Record<string, number>)[e.replace(/️/g, '')];
---
{i !== undefined && <i class:list={['px', `e${i}`, { lead }]} aria-hidden="true"></i>}
